# tradingagents plugin settings. Copy to ~/.tradingagents/.env; every line is optional.
# (To keep the file elsewhere, point TRADINGAGENTS_CLAUDE_ENV at it.)

# SEC asks EDGAR callers for a contact address. Set your own name and email.
#SEC_EDGAR_USER_AGENT=Your Name you@example.com

# Free key for FRED macro data (rates, CPI, yields, VIX):
# https://fred.stlouisfed.org/docs/api/api_key.html
#FRED_API_KEY=

# Alpha Vantage (alternative price/news/fundamentals vendor): https://www.alphavantage.co/support/#api-key
#ALPHA_VANTAGE_API_KEY=

# Screens StockTwits/Reddit posts for relevance before the sentiment analyst reads them.
#TYPESAFE_API_KEY=

# --- Optional: the original TradingAgents LangGraph pipeline -------------------
# Leave unset to run analyses on your Claude plan with the trading-analysis skill.
# Uncommenting the key adds the run_pipeline / run_backtest tools, which call the
# API and bill this key. The provider and model lines below apply only then.
#ANTHROPIC_API_KEY=
TRADINGAGENTS_LLM_PROVIDER=anthropic
TRADINGAGENTS_QUICK_THINK_LLM=claude-sonnet-5
TRADINGAGENTS_DEEP_THINK_LLM=claude-opus-5-5
TRADINGAGENTS_ANTHROPIC_EFFORT=medium
TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
TRADINGAGENTS_MAX_RISK_ROUNDS=1
#TA_MCP_MAX_CONCURRENT=2

# Turn off TradingAgents' start-up check for a newer release.
TRADINGAGENTS_NO_UPDATE_CHECK=1

# Options math: annual risk-free rate for Black-Scholes deltas and probabilities.
#TA_RISK_FREE_RATE=0.04
# Keep the Mac awake while pipeline jobs run (macOS caffeinate). 0 turns it off.
#TA_MCP_KEEP_AWAKE=1
