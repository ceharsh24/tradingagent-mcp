# Codex front end: overrides loaded on top of .env (shared settings such as
# SEC_EDGAR_USER_AGENT and FRED_API_KEY come from there). Copy to .env.codex.
# Codex's MCP entry points the server here with TRADINGAGENTS_ENV_FILE.
TRADINGAGENTS_FRONTEND=Codex

# Run the TradingAgents pipeline on your ChatGPT Plus/Pro plan (no API key).
# Sign in once:  .venv/bin/tradingagents login chatgpt
TRADINGAGENTS_LLM_PROVIDER=chatgpt
TRADINGAGENTS_QUICK_THINK_LLM=gpt-6-luna
TRADINGAGENTS_DEEP_THINK_LLM=gpt-6-sol
TRADINGAGENTS_OPENAI_REASONING_EFFORT=medium
